{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "htspark-statistics-practice",
  "main": "cloudflare/worker.ts",
  "account_id": "995a433224b8f0282882636cf841a137",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_server_modules"
  ],
  "assets": {
    "directory": "dist/cloudflare-assets",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "NODE_ENV": "production"
  },
  "observability": {
    "enabled": true
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html"
      ],
      "fallthrough": true
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "13b9e44460c545f59add94a2d396a2a2"
    }
  ],
  "alias": {
    "@nestjs/websockets/socket-module": "./cloudflare/optional-nest-modules.cjs",
    "@nestjs/microservices/microservices-module": "./cloudflare/optional-nest-modules.cjs",
    "@nestjs/microservices": "./cloudflare/optional-nest-modules.cjs"
  },
  "routes": [
    {
      "pattern": "htspark.xyz",
      "custom_domain": true,
      "zone_id": "6a03aae1b6a58e3b1ac78971a4646ef3"
    }
  ],
  "workers_dev": false,
  "preview_urls": false
}
